# Copy to .env.prod on the server, fill it in, then source it before invoking
# stack.sh. It is not committed, and it should not be world-readable:
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#   set -a && . ./.env.prod && set +a
#
# Development features have local defaults in this repository. `./stack.sh ...
# prod` treats production as a safety boundary: it requires the base values
# below and, for each selected integration, the corresponding real credentials.

# --- Required -------------------------------------------------------------

# Postgres password. Nothing else knows it; changing it later means changing it
# in the volume too, so pick it once:  openssl rand -base64 32
DB_PASSWORD=

# The origin browsers use. The WebSocket handshake accepts this and nothing
# else, so a typo here presents as "the room never connects".
PUBLIC_ORIGIN=https://live.tommy-huang.dev

# --- Optional -------------------------------------------------------------

# Loopback port the edge proxy forwards to. Change it if something else on this
# host already uses 8088 — the edge config must match.
FRONTEND_PORT=8088

# Retention, in days. ZERO MEANS KEEP FOREVER, which is the default everywhere:
# a deploy that started deleting data would be a terrible surprise. Choose per
# data type. Recordings and shared files delete their objects too; chat also
# clears its search index; the to-do list and calendar share one period.
RETENTION_RECORDINGS_DAYS=0
RETENTION_ATTACHMENTS_DAYS=0
RETENTION_CHAT_DAYS=0
RETENTION_AGENDA_DAYS=0
RETENTION_MEETINGS_DAYS=0
RETENTION_AUDIT_DAYS=0
RETENTION_PUBLISHED_EVENTS_DAYS=0

# --- Required with: prod turn ---------------------------------------------
# The address browsers reach the relay on. Must be the public IP or hostname,
# not localhost — a relay nobody can route to is a relay that does nothing.
# TURN_PUBLIC_HOST=live.tommy-huang.dev
# TURN_USERNAME=
# TURN_PASSWORD=

# --- Required with: prod oidc ---------------------------------------------
# Production never starts the bundled devidp. Point all three values at the
# real Keycloak/Entra/OIDC tenant.
# OIDC_ISSUER=https://id.example.com/realms/warroom
# OIDC_JWK_SET_URI=https://id.example.com/realms/warroom/protocol/openid-connect/certs
# OIDC_CLIENT_ID=warroomlive-web

# --- Required with: prod ai -----------------------------------------------
# Production never starts the deterministic devai fixture.
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# --- Required with: prod sfu (and prod recording) -------------------------
# Must be a matched key pair. The launcher passes it to the backend, LiveKit,
# webhook signer and Egress worker instead of using the checked-in dev pair.
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# --- Required with: prod recording ---------------------------------------
# Strong credentials for the bundled recording object store. They are also
# used by the backend's S3 client unless EGRESS_S3_* explicitly overrides them.
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# EGRESS_S3_BUCKET=recordings

# --- Required with: prod backup-s3 ---------------------------------------
# In production the backup shipper targets this external S3-compatible store;
# the bundled backup MinIO fixture is not started.
# RCLONE_CONFIG_S3_PROVIDER=AWS
# RCLONE_CONFIG_S3_ENDPOINT=https://s3.example.com
# RCLONE_CONFIG_S3_ACCESS_KEY_ID=
# RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=
# BACKUP_BUCKET=warroom-backups
# BACKUP_PASSPHRASE=
