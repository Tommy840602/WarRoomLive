# Copy to .env.prod on the server and fill in. docker compose reads it with
# --env-file; it is not committed, and it should not be world-readable:
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# Every value here has a development default somewhere in this repository.
# That is deliberate for `docker compose up` on a laptop and wrong on a host
# with a public address, so the production overlay refuses to start without the
# two that matter.

# --- Required -------------------------------------------------------------

# Postgres password. Nothing else knows it; changing it later means changing it
# in the volume too, so pick it once:  openssl rand -base64 32
DB_PASSWORD=

# The origin browsers use. The WebSocket handshake accepts this and nothing
# else, so a typo here presents as "the room never connects".
PUBLIC_ORIGIN=https://live.tommy-huang.dev

# --- Optional -------------------------------------------------------------

# Loopback port the edge proxy forwards to. Change it if something else on this
# host already uses 8088 — the edge config must match.
WARROOM_PORT=8088

# Retention, in days. ZERO MEANS KEEP FOREVER, which is the default everywhere:
# a deploy that started deleting data would be a terrible surprise. Choose per
# data type. Recordings and shared files delete their objects too; chat also
# clears its search index; the to-do list and calendar share one period.
RETENTION_RECORDINGS_DAYS=0
RETENTION_ATTACHMENTS_DAYS=0
RETENTION_CHAT_DAYS=0
RETENTION_AGENDA_DAYS=0
RETENTION_AUDIT_DAYS=0
RETENTION_PUBLISHED_EVENTS_DAYS=0

# --- Only with the TURN overlay -------------------------------------------
# The address browsers reach the relay on. Must be the public IP or hostname,
# not localhost — a relay nobody can route to is a relay that does nothing.
# TURN_PUBLIC_HOST=live.tommy-huang.dev
