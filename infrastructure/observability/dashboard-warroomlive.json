{
  "uid": "warroomlive-overview",
  "title": "WarRoomLive Overview",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Signaling connections",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(warroomlive_signaling_connections_active)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rooms / members (cluster)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "max(warroomlive_rooms_active)",
          "refId": "A"
        },
        {
          "expr": "max(warroomlive_rooms_members)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Event outbox backlog",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "max(warroomlive_events_backlog)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Collab connections / open docs",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(collab_connections_active)",
          "refId": "A"
        },
        {
          "expr": "sum(collab_documents_open)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Signaling messages in by type (msg/s)",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (type) (rate(warroomlive_signaling_messages_in_total[1m]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Signaling processing mean (s)",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(warroomlive_signaling_message_processing_seconds_sum[5m]) / clamp_min(rate(warroomlive_signaling_message_processing_seconds_count[5m]), 1e-9)",
          "legendFormat": "mean",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CRDT updates (ops/s) & rejections",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(collab_updates_total[1m])",
          "legendFormat": "updates/s",
          "refId": "A"
        },
        {
          "expr": "sum by (reason) (rate(collab_rejections_total[5m]))",
          "legendFormat": "rejected: {{reason}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Events published / indexed (evt/s)",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (type) (rate(warroomlive_events_published_total[1m]))",
          "legendFormat": "published: {{type}}",
          "refId": "A"
        },
        {
          "expr": "sum by (type) (rate(indexer_events_consumed_total[1m]))",
          "legendFormat": "indexed: {{type}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Outbox backlog & publish rate",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "warroomlive_events_backlog",
          "legendFormat": "backlog",
          "refId": "A"
        },
        {
          "expr": "sum by (type) (rate(warroomlive_events_published_total[5m]))",
          "legendFormat": "published {{type}}/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "SFU rooms & participants (sfu overlay)",
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "livekit_rooms",
          "legendFormat": "rooms",
          "refId": "A"
        },
        {
          "expr": "livekit_participants",
          "legendFormat": "participants",
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "SFU media quality: NACK / packet rate (sfu overlay)",
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(livekit_nack_total[1m]))",
          "legendFormat": "nack/s",
          "refId": "A"
        },
        {
          "expr": "sum by (direction) (rate(livekit_packet_total[1m]))",
          "legendFormat": "packets {{direction}}/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Redis backplane command latency p99 (failover visibility)",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(lettuce_command_completion_seconds_bucket[1m])))",
          "legendFormat": "p99 completion",
          "refId": "A"
        },
        {
          "expr": "sum(rate(lettuce_command_completion_seconds_count[1m]))",
          "legendFormat": "commands/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Indexer health: consumed / failed / deduped",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(indexer_events_consumed_total[5m]))",
          "legendFormat": "consumed/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(indexer_events_failed_total[5m]))",
          "legendFormat": "failed/s",
          "refId": "B"
        },
        {
          "expr": "sum(rate(indexer_events_deduped_total[5m]))",
          "legendFormat": "deduped/s",
          "refId": "C"
        }
      ]
    }
  ]
}