{
  "uid": "warroomlive-overview",
  "title": "WarRoomLive Overview",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Signaling connections",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "targets": [{ "expr": "sum(warroomlive_signaling_connections_active)", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rooms / members (cluster)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "targets": [
        { "expr": "max(warroomlive_rooms_active)", "refId": "A" },
        { "expr": "max(warroomlive_rooms_members)", "refId": "B" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Event outbox backlog",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "targets": [{ "expr": "max(warroomlive_events_backlog)", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Collab connections / open docs",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "targets": [
        { "expr": "sum(collab_connections_active)", "refId": "A" },
        { "expr": "sum(collab_documents_open)", "refId": "B" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Signaling messages in by type (msg/s)",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum by (type) (rate(warroomlive_signaling_messages_in_total[1m]))",
        "legendFormat": "{{type}}",
        "refId": "A"
      }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Signaling processing mean (s)",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(warroomlive_signaling_message_processing_seconds_sum[5m]) / clamp_min(rate(warroomlive_signaling_message_processing_seconds_count[5m]), 1e-9)",
        "legendFormat": "mean",
        "refId": "A"
      }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CRDT updates (ops/s) & rejections",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(collab_updates_total[1m])", "legendFormat": "updates/s", "refId": "A" },
        { "expr": "sum by (reason) (rate(collab_rejections_total[5m]))", "legendFormat": "rejected: {{reason}}", "refId": "B" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Events published / indexed (evt/s)",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (type) (rate(warroomlive_events_published_total[1m]))", "legendFormat": "published: {{type}}", "refId": "A" },
        { "expr": "sum by (type) (rate(indexer_events_consumed_total[1m]))", "legendFormat": "indexed: {{type}}", "refId": "B" }
      ]
    }
  ]
}
