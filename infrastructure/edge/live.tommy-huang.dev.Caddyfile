# Site block for an existing Caddy edge that already serves other hosts on this
# machine. Add it to that Caddyfile (or drop it in the directory that Caddyfile
# imports) and reload — do not start a second Caddy, and do not use this
# repository's docker-compose.tls.yml here: it binds :80/:443 and would collide
# with the edge already holding them.
#
#   caddy validate --config /etc/caddy/Caddyfile
#   systemctl reload caddy        # or: docker compose exec caddy caddy reload …
#
# WARROOM_PORT must match docker-compose.prod.yml (default 8088). The stack
# binds it to loopback, so this proxy is the only way in.
live.tommy-huang.dev {
	# reverse_proxy handles WebSocket upgrades transparently, so /ws/signal and
	# /ws/doc need no special casing. Caddy sets X-Forwarded-For to the client;
	# infrastructure/edge/real-ip.conf is what makes the app trust it.
	reverse_proxy 127.0.0.1:8088 {
		# Recordings and shared files stream straight through from the object
		# store, and can be large. Default is fine for bodies, but uploads go
		# through here too: a presigned PUT carries the whole file.
		request_body {
			max_size 64MB
		}

		# A meeting's WebSocket is idle between messages for long stretches and
		# must not be reaped mid-call.
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}

	encode zstd gzip

	# The app is same-origin by construction (nginx inside proxies /api, /ws,
	# /ws/doc, /objects and /recordings), so a strict frame policy costs nothing
	# and closes clickjacking against the room controls.
	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# getUserMedia needs an explicit grant once the app is framed by policy.
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self)"
	}
}
